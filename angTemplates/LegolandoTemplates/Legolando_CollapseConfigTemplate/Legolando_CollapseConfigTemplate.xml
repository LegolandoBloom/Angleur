    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->


    <!-- ____________________________________[2]______________________________________________ -->
    <!--                          Templates made by Legolando                                  -->
    <!-- ____________________________________[2]______________________________________________ -->
    <Button name="Legolando_CollapseConfigTemplate_Angleur" mixin="Legolando_CollapseConfigMixin_Angleur" inherits="Legolando_SimpleSquareButtonTemplate_Angleur" virtual="true">
        <KeyValues>
            <KeyValue key="savedVarTable" value="" type="table"/>
        </KeyValues>
        <Scripts>
            <OnClick>
                if self.popup:IsShown() then
                    self.popup:Hide()
                else
                    self.popup:Show()
                end
            </OnClick>
            <OnHide>
                self.popup:Hide()
            </OnHide>
        </Scripts>
        <Frames>
            <!-- Options: Legolando_PortedSecureDialogBorderTemplate_Angleur | Legolando_PortedSecureDialogBorderDarkTemplate_Angleur | Legolando_PortedSecureDialogBorderOpaqueTemplate_Angleur | Legolando_PortedSecureDialogBorderNoCenterTemplate_Angleur -->
            <Frame name="$parent_Popup" parentKey="popup" hidden="true" enableMouse="true" inherits="Legolando_PortedSecureDialogBorderOpaqueTemplate_Angleur">
                <Size x="300" y="150"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontNormal" text="Template Title">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="18" y="-19"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Frame name="$parent_Tabs" parentKey="tabs" inherits="Legolando_PortedTabSystemTemplate_Angleur">    
                        <Size x="1" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="8" y="6"/>
                        </Anchors>
                        <KeyValues>
                            <KeyValue key="spacing" value="0.1" type="number"/>
                        </KeyValues>
                    </Frame>
                    <Button parentKey="$parent.CloseButton" inherits="UIPanelCloseButton">
                        <Anchors>
                            <Anchor point="TOPRIGHT" x="-2" y="-2"/>
                        </Anchors>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Button>

    <Frame name="Legolando_CollapseConfigTemplate2_Angleur" mixin="Legolando_CollapseConfigMixin2_Angleur" virtual="true">
        <Size x="1" y="1"/>
        <KeyValues>
            <KeyValue key="savedVarTable" value="" type="table"/>
        </KeyValues>
        <Frames>
             <!-- Options: Legolando_PortedSecureDialogBorderTemplate_Angleur | Legolando_PortedSecureDialogBorderDarkTemplate_Angleur | Legolando_PortedSecureDialogBorderOpaqueTemplate_Angleur | Legolando_PortedSecureDialogBorderNoCenterTemplate_Angleur -->
            <Frame name="$parent_Popup" parentKey="popup" hidden="true" enableMouse="true" inherits="Legolando_PortedSecureDialogBorderOpaqueTemplate_Angleur">
                <Size x="300" y="150"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="title" inherits="GameFontNormal" text="">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="18" y="-19"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        self:RegisterEvent("GLOBAL_MOUSE_DOWN")
                    </OnLoad>
                    <OnEvent>
                        if event == "GLOBAL_MOUSE_DOWN" then
                            if not self:IsShown() then return end
                            if self:IsMouseOver() then return end
                            self:Hide()
                        end
                    </OnEvent>
                </Scripts>
                <Frames>
                    <Frame name="$parent_Tabs" parentKey="tabs" inherits="Legolando_PortedTabSystemTemplate_Angleur">    
                        <Size x="1" y="1"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="8" y="6"/>
                        </Anchors>
                        <KeyValues>
                            <KeyValue key="spacing" value="0.1" type="number"/>
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Button name="$parent_ExpandButton" parentKey="expandButton" inherits="Legolando_SimpleArrowPopoutButtonTemplate_Angleur">
                <Size x="16" y="16"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="0" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick inherit="append">
                        local parent = self:GetParent()
                        if parent.popup:IsShown() then
                            parent.popup:Hide()
                        else
                            parent.popup:Show()
                        end
                    </OnClick>
                    <OnHide>
                        self:GetParent().popup:Hide()
                    </OnHide>
                </Scripts>
            </Button>
        </Frames>
    </Frame>
