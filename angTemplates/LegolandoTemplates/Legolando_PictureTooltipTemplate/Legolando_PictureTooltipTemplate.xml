<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    
    <Script file="Legolando_PictureTooltipTemplate.lua"/>
    
    <!-- ____________________________________________________________________________________________________________________________________________________________________________________________________ -->
    <!-- IMPORTANT: When creating any GameTooltip inherited by GameTooltipTemplate: if you don't give it a UNIQUE name(not just parentKey, but an actual name with name="A_Name"), it won't work properly -->
                                    <!-- For the templates below, this means you need to give the frame you create using them a unique name -->,
    <!-- ____________________________________________________________________________________________________________________________________________________________________________________________________ -->

    <GameTooltip name= "Legolando_PictureTooltipTemplate_Angleur" mixin="Legolando_PictureTooltipMixin_Angleur" inherits="GameTooltipTemplate" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parent_Texture" parentKey="texture">
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnHide inherit="append" method="OnHide"/>
        </Scripts>
    </GameTooltip>

    <GameTooltip name= "Legolando_FrameAnchorableTooltipTemplate_Angleur" mixin="Legolando_FrameAnchorableTooltipMixin_Angleur" inherits="GameTooltipTemplate" virtual="true">
        <Scripts>
            <OnHide inherit="append" method="OnHide"/>
        </Scripts>
    </GameTooltip>
</Ui>