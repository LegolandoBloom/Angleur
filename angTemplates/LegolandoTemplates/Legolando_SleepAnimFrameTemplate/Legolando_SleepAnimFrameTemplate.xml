<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <Script file="Legolando_SleepAnimFrameTemplate.lua"/>

    <Frame name="Legolando_SleepAnimFrameTemplate_Angleur" mixin="Legolando_SleepAnimFrameMixin_Angleur" virtual="true">
        <Size x="64" y="64"/>
        <Layers>
            <Layer level="OVERLAY">
                <Texture name="$parent_Texture" parentKey="texture">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Animations>
            <AnimationGroup parentKey="anim" looping="REPEAT" setToFinalAlpha="true">
                <FlipBook smoothing="NONE" childKey="texture" duration="2" order="1" flipBookRows="1" flipBookColumns="4" flipBookFrames="4" flipBookFrameWidth="64" flipBookFrameHeight="64"/>
            </AnimationGroup>
        </Animations>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnHide>
                self.anim:Stop()
            </OnHide>
            <OnShow>
                self.anim:Play()
            </OnShow>
        </Scripts>
    </Frame>
</Ui>