    <EditBox name="Legolando_EditBoxNoTextureTemplate_Angleur" mixin="Legolando_EditBoxNoTextureMixin_Angleur" autoFocus="false" virtual="true">
        <KeyValues>
            <KeyValue key="showDebugBorder" value="false" type="boolean"/>
        </KeyValues>
        <FontString inherits="ChatFontNormal"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="debugBorder" setAllPoints="true" hidden="true">
                    <Color r="1" g="0" b="0" a="0.2"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEditFocusGained method="OnEditFocusGained"/>
            <OnEditFocusLost method="OnEditFocusLost"/>
            <OnTabPressed>
                self:ClearFocus()
            </OnTabPressed>
            <OnEnterPressed>
                self:ClearFocus()
            </OnEnterPressed>
            <OnEscapePressed>
                self:ClearFocus()
            </OnEscapePressed>
        </Scripts>
    </EditBox>
    

