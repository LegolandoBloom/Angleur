    <Frame name="Legolando_MinSecEditBoxesTemplate_Angleur" mixin="Legolando_MinSecEditBoxesMixin_Angleur" toplevel="true" virtual="true">
        <Size x="38" y="25"/>
        <KeyValues>
            <!--                                                IMPORTANT!
            __________________________________________________ Tab-Swapping __________________________________________________
            When .minutes SetsFocus to .seconds during OnTabPressed, .seconds receives focus only AFTER the next frame update
               (even though .minutes can force-clear focus from itself without waiting for frame update with ClearFocus())
            the "tabbing" flag will allow us to query from external code whether the minute-box's OnEditFocusLost->SaveToTable 
            happened during the tab swap. 
                    Example: Angleur uses this to Hide the MinSec on SaveToTable ONLY when we aren't tab-swapping
            __________________________________________________________________________________________________________________ 
             -->
            <KeyValue key="tabbing" type="boolean" value="false"/>
        </KeyValues>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parent_Background" parentKey="background" file="Interface/COMMON/Common-CheckBox-Background">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parent"/>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parent"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString text="min sec" inherits="GameFontHighlightExtraSmall">
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="TOP" x="0" y="0"/>
                    </Anchors>
                    <Color r="1.0" g="0.82" b="0.0"/>
                </FontString>
                <FontString text=":" inherits="GameFontNormalLarge">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
		<Frames>
			<EditBox name="$parent_Min" letters="2" parentKey="minutes" autoFocus="false" numeric="true" enableMouse="true" inherits="Legolando_EditBoxNoTextureTemplate_Angleur" hidden="false">
				<Size x="18" y="18"/>
                 <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="$parent" relativePoint="TOP" x="2"/>
                </Anchors>
                <KeyValues>
                    <KeyValue key="showDebugBorder" value="false" type="boolean"/>
                </KeyValues>
				<Scripts>
                    <!-- Part of the ____________ "Tab-Swapping" ____________ flag mentioned above -->
                    <OnTabPressed inherit="append">
                        local parent = self:GetParent()
                        parent.tabbing = true
                        parent.seconds:SetFocus()
                    </OnTabPressed>
				</Scripts>
			</EditBox>
            <EditBox name="$parent_Sec" letters="2" parentKey="seconds" autoFocus="false" numeric="true" enableMouse="true" inherits="Legolando_EditBoxNoTextureTemplate_Angleur" hidden="false">
                <Size x="18" y="18"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOP" x="4" y="0"/>
                </Anchors>
                <KeyValues>
                    <KeyValue key="showDebugBorder" value="false" type="boolean"/>
                </KeyValues>
                <Scripts>
                    <!-- Part of the ____________ "Tab-Swapping" ____________ flag mentioned above -->
                    <OnEditFocusGained inherit="append">
                        local parent = self:GetParent()
                        if parent.tabbing then
                            parent.tabbing = false
                        end
                    </OnEditFocusGained>
				</Scripts>
            </EditBox>
		</Frames>
        <Scripts>
            <OnShow method="OnShow"/>
        </Scripts>
	</Frame>

</Ui>