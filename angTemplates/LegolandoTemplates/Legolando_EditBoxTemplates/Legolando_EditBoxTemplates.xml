        <Scripts>
            <OnEnterPressed>
                self:ClearFocus()
            </OnEnterPressed>
            <OnTabPressed>
                self:ClearFocus()
            </OnTabPressed>
            <OnEditFocusGained method="OnEditFocusGained"/>
            <OnEditFocusLost method="OnEditFocusLost"/>
            <OnCursorChanged method="OnCursorChanged"/>
            <OnTextChanged method="OnTextChanged"/>
        </Scripts>
    </EditBox>

