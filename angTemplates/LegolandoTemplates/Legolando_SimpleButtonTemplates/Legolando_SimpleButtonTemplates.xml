<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Script file="Legolando_SimpleButtonTemplates.lua"/>

    <Button name="Legolando_SimpleSquareButtonTemplate_Angleur" virtual="true">
        <Size x="26" y="26"/>
        <Layers>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture name="$parentIcon" file="Interface/BUTTONS/UI-OptionsButton" parentKey="icon">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <KeyValues>
            <KeyValue key="tooltip" value="Tooltip Text" type="string"/>
        </KeyValues>
        <Scripts>
        <OnEnter>
            GameTooltip:SetOwner(self, "ANCHOR_RIGHT", 0, -20)
            GameTooltip:AddLine(self.tooltip)
            GameTooltip:Show()
        </OnEnter>
        <OnLeave>
            GameTooltip:Hide()
        </OnLeave>
        <OnMouseDown>
            if self:IsEnabled() then
            self.icon:SetPoint("CENTER", -1, -1);
            end
        </OnMouseDown>
        <OnMouseUp>
            self.icon:SetPoint("CENTER", 0, 0);
        </OnMouseUp>
        <OnDisable>
            SetDesaturation(self.icon, true);
            self.icon:SetAlpha(0.5);
        </OnDisable>
        <OnEnable>
            SetDesaturation(self.icon, false);
            self.icon:SetAlpha(1.0);
        </OnEnable>
        </Scripts>
        <NormalTexture file="Interface\Buttons\SquareButtonTextures">
        <TexCoords left="0.01562500" right="0.42187500" top="0.23437500" bottom="0.64062500"/>
        </NormalTexture>
        <PushedTexture file="Interface\Buttons\SquareButtonTextures">
        <TexCoords left="0.45312500" right="0.85937500" top="0.23437500" bottom="0.64062500"/>
        </PushedTexture>
        <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
    </Button>

    
    <!--              
    Legolando Note: 
        I altered the original texture crop coordinates from "EquipmentFlyoutPopoutButtonTemplate" 
              to make the button more precise, only clickable where the texture is visible.                                                                                                                               
                                                                                            ┌───────────────────────┐                                          
                                                                                            │      My Version       │                                          
                                                                                            └───────────────────────┘                                          
                                                                                                                                                    
        Normal Coords(Rect):                                                       Normal Coords(Rect):                                                
            Top: 0         __> Swap Top & Bottom                   ┌─┐                 Top: 0.062     __> Swap Top & Bottom                            
            Bottom: 0.5    __> to turn upside down                 │ └─┐               Bottom: 0.437   __> to turn upside down                         
            Left: 0.15625                                          │   └─┐             Left: 0.188                                                     
            Right: 0.84375                                  ───────┘     └─┐           Right: 0.828                                                    
                                                                            │                                                                           
        Highlight Coords(Rect):                             ───────┐     ┌─┘       Highlight Coords(Rect):                                             
            Top: 0.5       __> Swap Top & Bottom                   │   ┌─┘             Top: 0.562     __> Swap Top & Bottom                            
            Bottom: 1       __> to turn upside down                │ ┌─┘               Bottom: 0.937   __> to turn upside down                         
            Left: 0.15625                                          └─┘                 Left: 0.188                                                     
            Right: 0.84375                                                            Right: 0.828                                                    
    -->
    <!-- The edited version of blizzard FrameXML's: EquipmentFlyoutPopoutButtonTemplate -->
    <Button name="Legolando_SimpleArrowPopoutButtonTemplate_Angleur" mixin="Legolando_SimpleArrowPopoutButtonTemplateMixin_Angleur" hidden="false" virtual="true">
        <Size x="8" y="8"/>
        <KeyValues>
            <KeyValue key="expanded" value="false" type="boolean"/>
        </KeyValues>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnClick>
                self:SetState()
            </OnClick>
        </Scripts>
        <NormalTexture file="Interface\PaperDollInfoFrame\UI-GearManager-FlyoutButton" parentKey="normal" setAllPoints="true"/>
        <HighlightTexture file="Interface\PaperDollInfoFrame\UI-GearManager-FlyoutButton" parentKey="highlight" setAllPoints="true"/>
    </Button>
</Ui>