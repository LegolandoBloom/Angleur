<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="Angleur_ThanksFrame_SupporterNameTemplate" virtual="true">
        <Size x="100" y="30"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parent_NameText" parentKey="text" inherits="FriendsFont_Normal">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="0" y="-8"/>
                    </Anchors>
                </FontString>
                <FontString name="$parent_SmallText" parentKey="smallText" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.text" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="logo">
                    <Size x="24" y="24"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>
