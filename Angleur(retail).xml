<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    
    <!-- TAB 1 STUFF -->
    <CheckButton parent="Angleur_ConfigPanel_Tab1_Contents" name="$parent_RaftCheckBox"  parentKey="raftEnable" inherits="MyCheckboxTemplate">
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="45" y="-43"/>
        </Anchors>
        <Frames>
            <Frame name="$parent_DropDown" parentKey="dropDown" inherits="UIDropDownMenuTemplate" hidden="true">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parent" relativePoint="RIGHT"/>
                </Anchors>
            </Frame>
        </Frames>
    </CheckButton>

    <CheckButton parent="Angleur_ConfigPanel_Tab1_Contents" name="$parent_OversizedBobberCheckBox" parentKey="oversizedBobberEnable" inherits="MyCheckboxTemplate">
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="128" y="-72"/>
        </Anchors>
    </CheckButton>

    <CheckButton parent="Angleur_ConfigPanel_Tab1_Contents" name="$parent_CrateBobberCheckBox" parentKey="crateBobberEnable" inherits="MyCheckboxTemplate">
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="120" y="-100"/>
        </Anchors>
        <Frames>
            <Frame name="$parent_DropDown" parentKey="dropDown" inherits="UIDropDownMenuTemplate" hidden="true">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parent" relativePoint="RIGHT"/>
                </Anchors>
            </Frame>
        </Frames>
    </CheckButton>


    <!-- TAB 3 STUFF -->
    <CheckButton parent="Angleur_ConfigPanel_Tab3_Contents" name="$parent_OffInteract" parentKey="offInteract" inherits="MyCheckboxTemplate">
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="142" y="-35"/>
        </Anchors>
    </CheckButton>

    <CheckButton parent="Angleur_ConfigPanel_Tab3_Contents" name="$parent_SoftIconOff" parentKey="softIconOff" inherits="MyCheckboxTemplate">
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="121" y="-83"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="disabledTexture" file="interface/common/voicechat-muted.blp" hidden="true">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parent_Text" relativePoint="RIGHT" x="25" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="hook" file="interface/cursor/crosshair/fishing.blp">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parent_Text" relativePoint="RIGHT" x="25" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </CheckButton>

    <!-- ALERT ANIMATION -->
    <Frame parent="Angleur" name="AngleurSet_AlertAnim" frameStrata="TOOLTIP" toplevel="true" inherits="ActionBarButtonSpellActivationAlert" hidden="true">
        <Size x="64" y="64"/>
        <Scripts>
            <OnEnter>
                self:Hide()
            </OnEnter>
        </Scripts>
    </Frame>

</Ui>